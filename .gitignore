# =============================================================================
# Root .gitignore -- the backstop for the whole monorepo. backend/ and frontend/
# have their own, narrower files; everything dangerous is repeated here on
# purpose so a stray `git add -A` from the repo root can never pick it up.
# Verify any path with:  git check-ignore -v <path>
# =============================================================================

# --- Secrets & credentials (NEVER commit) ------------------------------------
.env
.env.*
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
credentials*.json
service-account*.json
*secret*.json
secrets/
.secrets
.netrc

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/
.eggs/
pip-wheel-metadata/
# stray wheels from `pip download` (a past session dropped some in the repo root)
*.whl

# --- Node / frontend ------------------------------------------------------------
node_modules/
.vite/
*.tsbuildinfo
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.parcel-cache/
dist-ssr/
*.local

# --- Prisma / database ------------------------------------------------------------
# prisma-client-py generates INTO the active interpreter's site-packages (no
# `output` in schema.prisma), so there is no generated-client directory in the
# repo to ignore. schema.prisma and backend/migrations/ ARE tracked -- never
# ignore them.
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump
dump*.sql
*.pgdump
pgdata/
postgres-data/

# --- Runtime artifacts --------------------------------------------------------------
*.log
logs/
output.txt
output.log
tmp/
temp/
.cache/
# eval/.cache is regenerated by the eval scripts every run. eval/results.md,
# eval/thresholds.json and eval/fixtures/judge_cache.json ARE tracked.
eval/.cache/
# load-test scratch outside the committed results/
backend/scripts/loadtest/*.log

# large demo media (record locally; keep a placeholder so the folder exists)
docs/media/*.mov
docs/media/*.mp4
docs/media/*.webm
docs/media/*.gif
!docs/media/.gitkeep

# generated SBOMs (CI uploads them as artifacts)
*.cdx.json
sbom*.json

# --- Local-only planning docs / scripts (kept out of the repo on purpose) -------------
# The v1/v2 spec files are local design notes, not project artifacts (decision
# recorded in docs/PROGRESS.md). seed.py / run_seeded.py are untracked local
# convenience scripts; scripts/seed_demo.py is the tracked, idempotent one.
backend/wealth-agent-spec.md
backend/wealth-agent-v2-spec.md
backend/seed.py
backend/run_seeded.py

# --- Deploy tooling state -----------------------------------------------------------
.vercel/
.render/
.fly/
.netlify/
terraform.tfstate*
.terraform/
*.tfvars

# --- OS / editor / agent tooling ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.claude/settings.local.json
.claude/worktrees/

# --- Markdown / docs: local-only, never pushed ---------------------------------
# Every .md in the project (README, CLAUDE.md, MEMORY.md, docs/, reports,
# eval/results.md, ...) stays on this machine. Already-tracked ones were
# untracked with `git rm --cached` (files kept on disk).
*.md
**/*.md

# ...except the project README, which IS pushed to GitHub
!/README.md
