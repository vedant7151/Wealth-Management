DATABASE_URL=
GEMINI_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=

# LangSmith Observability
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
HUGGINGFACE_API_KEY=

# Clerk auth (placeholder scaffold -- see backend/auth.py). Leave both unset
# to run api.py without login: every request resolves to a fixed demo user
# and all endpoints stay open. Fill in once you have a real Clerk app:
#   CLERK_JWKS_URL = https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
#   CLERK_ISSUER   = https://<your-app>.clerk.accounts.dev

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Rate limiting (backend/ratelimit.py). All optional -- shown here with
# their defaults.
# REDIS_URL=                     # if set, uses Redis instead of the
#                                 # Postgres-backed RateLimitHit table
# RUN_LIMIT=3
# RUN_WINDOW_SECONDS=3600
# GLOBAL_API_LIMIT=120
# WRITE_LIMIT=20
# DAILY_LLM_BUDGET=18
# RUN_LOCK_TTL_SECONDS=300
# TRUSTED_PROXIES=               # comma-separated proxy IPs allowed to set
#                                 # X-Forwarded-For; empty means never trust it

# Retrieval / writer context tuning (backend/agent.py). Optional.
# RETRIEVAL_MAX_DISTANCE=1.0
# CONTEXT_CHAR_BUDGET=4000

# Logging / tracing
# LOG_LEVEL=INFO
# REDACT_CLIENT_NAMES_IN_TRACES=true

# Injection screening (backend/compliance/injection_guard.py). Optional.
# INJECTION_SCORE_THRESHOLD=0.75

# Provider abstraction (backend/llm_client.py). All optional -- shown here
# with their defaults. Model names and provider order are env-configurable
# so a model deprecation/rename doesn't need a code change.
# LLM_PROVIDER_ORDER=gemini,groq   # fallback chain order for generate_text/generate_json
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_CHAT_MODEL=llama-3.1-8b-instant
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384                # asserted on every embedding response; mismatch raises
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_MAX_CONCURRENCY=4
# LLM_CALL_TIMEOUT_SECONDS=30
# LLM_MAX_ATTEMPTS_PER_PROVIDER=2
# LLM_RETRY_BASE_DELAY_SECONDS=0.5
# LLM_RETRY_MAX_DELAY_SECONDS=8
# CIRCUIT_BREAKER_THRESHOLD=3      # consecutive failures before a provider is skipped
# CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# Admin usage endpoint (GET /api/admin/usage). Comma-separated real Clerk
# user ids allowed to call it; empty means nobody can (403 for everyone).
# ADMIN_USER_IDS=

# Background runs (backend/runs.py). Optional.
# RUN_TIMEOUT_SECONDS=600

# Phase 7: PDF download / CSV holdings upload rate limits (backend/ratelimit.py).
# PDF_LIMIT=10
# PDF_WINDOW_SECONDS=60
# UPLOAD_LIMIT=5
# UPLOAD_WINDOW_SECONDS=60

# Phase 7: CSV holdings upload validation caps (backend/holdings.py).
# CSV_MAX_ROWS=500
# CSV_MAX_BYTES=262144

# Phase 7: email delivery (backend/delivery.py). Disabled by default --
# POST /api/briefings/{id}/deliver always 501s unless EMAIL_DELIVERY_ENABLED
# is explicitly set to "true". Only an approved briefing can be delivered,
# and only to a recipient whose domain is in EMAIL_ALLOWED_RECIPIENT_DOMAINS.
# EMAIL_DELIVERY_ENABLED=false
# EMAIL_ALLOWED_RECIPIENT_DOMAINS=      # comma-separated, e.g. ourfirm.com
# EMAIL_FROM_ADDRESS=
# EMAIL_PROVIDER=resend                 # resend | sendgrid
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# Phase 8: demo mode (backend/demo_mode.py). "auto" (default) activates
# demo mode automatically when GEMINI_API_KEY is unset/empty -- exactly
# docker-compose's `local` profile with no keys configured -- "true"
# forces it unconditionally, "false" disables it (the daily-budget
# quota-exhausted fallback in api.py's /run still applies independently
# of this flag). A demo-served Briefing always has isDemo=true in its API
# response and a visible UI badge -- never silently indistinguishable
# from a real one.
# DEMO_MODE=auto

# Phase 8: packaging/runtime tuning (backend/Dockerfile, api.py). All
# optional -- shown here with their defaults.
# PORT=8010
# WEB_CONCURRENCY=1              # uvicorn worker processes -- keep at 1
#                                 # unless/until the in-process rate
#                                 # limiter, circuit breakers, and SSE
#                                 # pub-sub are moved to a shared store
#                                 # (see docs/PROGRESS.md's Known issues)
# GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=25   # how long SIGTERM shutdown waits
#                                         # for in-flight background runs
#                                         # to finish before giving up

# ---------------------------------------------------------------------------
# Production hardening (Phase 10) -- backend/settings.py validates ALL of
# these at startup and exits 78 with a list of variable NAMES (never values)
# if anything is missing/invalid. Run `python settings.py` to check a config.
# ---------------------------------------------------------------------------
# APP_ENV=dev                    # dev (default, permissive) | prod. In prod the
#                                 # process REFUSES to start with CORS "*", demo
#                                 # auth (Clerk unset), DEBUG on, a non-https
#                                 # CORS origin, no METRICS_TOKEN, missing
#                                 # provider keys (unless DEMO_MODE=true), or
#                                 # LOG_LEVEL=DEBUG.
# DEBUG=false
# Clerk token verification (backend/auth.py)
# CLERK_AUDIENCE=                # enforce `aud` (only if your JWT template sets one)
# CLERK_AUTHORIZED_PARTIES=      # comma-separated frontend origins; enforces `azp`
# CLERK_LEEWAY_SECONDS=10
# CLERK_JWKS_CACHE_SECONDS=3600
# CLERK_JWKS_REFRESH_MIN_INTERVAL_SECONDS=30
# ADMIN_USER_IDS=                # comma-separated Clerk user ids
# ADMIN_ROLE_CLAIM=role          # signed session-token claim (dotted path ok) whose value "admin" grants admin
# HTTP hardening
# MAX_REQUEST_BODY_BYTES=1048576
# HSTS_MAX_AGE_SECONDS=31536000
# MAX_PAGE_SIZE=100
# MAX_THEMES=10
# MAX_THEME_CHARS=120
# MAX_NAME_CHARS=100
# MAX_BRIEFING_CHARS=50000
# MAX_CLIENTS_PER_USER=50
# Database pool / timeouts (applied to DATABASE_URL by settings.make_prisma)
# DB_POOL_SIZE=5
# DB_POOL_TIMEOUT_SECONDS=10
# DB_CONNECT_TIMEOUT_SECONDS=10
# DB_STATEMENT_TIMEOUT_MS=5000   # server-side cap on pgvector similarity queries
# Retention (backend/retention.py; cron only deletes when RETENTION_ENABLED=true)
# RETENTION_ENABLED=false
# RETENTION_CHUNK_DAYS=14
# RETENTION_SEARCH_CACHE_DAYS=7
# RETENTION_API_CALL_LOG_DAYS=90
# RETENTION_RATE_LIMIT_HIT_DAYS=2
# Reliability / concurrency
# MAX_CONCURRENT_RUNS=4          # POST /run -> 503 above this many in-flight runs
# LLM_MAX_CONCURRENCY=4          # global cap on simultaneous provider calls
# Observability
# METRICS_ENABLED=true
# METRICS_TOKEN=                 # required in prod; scrape with `Authorization: Bearer <token>`
# LOG_MAX_MESSAGE_CHARS=2000
# LOG_INCLUDE_CLIENT_NAMES=false # client names are never logged unless this is true
# LANGSMITH_PROJECT_SUFFIX_ENV=true  # LangSmith project = <LANGCHAIN_PROJECT or wealth-agent>-<APP_ENV>
# SENTRY_DSN=                    # optional; needs `pip install -r requirements-optional.txt`
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ---------------------------------------------------------------------------
# Release pass additions (embeddings, recency, models, test/dev switches)
# ---------------------------------------------------------------------------
# EMBEDDING_PROVIDER=gemini      # gemini (default; uses GEMINI_API_KEY) | huggingface (needs HF credits)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# HF_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# INJECTION_MODEL=meta-llama/llama-prompt-guard-2-86m   # Groq classifier used as the injection screen
# SOURCE_MAX_AGE_DAYS=5          # sources must be PUBLISHED within this many days
# MAX_CITATIONS=8                # target number of distinct sources per briefing
# RETRIEVAL_CANDIDATES_PER_THEME=16
# TAVILY_MAX_RESULTS=10
# CSP_API=default-src 'none'; frame-ancestors 'none'; base-uri 'none'
# LANGCHAIN_TRACING_V2=true      # set by the app; shown for completeness
# TRACE_HIDE_PAYLOADS=           # unset = hidden in prod, visible in dev
# Test/dev only -- NEVER set in production:
# MOCK_DB=1                      # in-memory DB stand-in (offline tests / local graph run)
# RATELIMIT_STORE=memory         # force the in-process rate-limit store (tests)

