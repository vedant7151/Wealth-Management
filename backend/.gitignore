# backend/.gitignore -- narrower than the root one (which also applies); kept so
# the rules travel with the directory.

# Secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
secrets/

# Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.hypothesis/

# Test / lint / type-check caches and coverage data
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Output / runtime
output.txt
output.log
*.log
tmp/

# Local-only scripts (the tracked equivalent is scripts/seed_demo.py)
seed.py
run_seeded.py

# Local-only design notes
wealth-agent-spec.md
wealth-agent-v2-spec.md

# Prisma (the generated client lives in site-packages; schema.prisma and
# migrations/ are tracked)
*.prisma-*
*.db
*.sqlite*

# Local DB dumps / generated SBOMs
*.sql.gz
dump*.sql
*.cdx.json

# IDE
.vscode/
.idea/

# Native-deploy Prisma engine cache (Render builds fetch it here)
.prisma-cache/
