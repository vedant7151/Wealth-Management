generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
  previewFeatures      = ["postgresqlExtensions"]
  output               = "venv/Lib/site-packages/prisma"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model ClientProfile {
  id               String     @id @default(uuid())
  name             String
  portfolio_themes String[]
  briefings        Briefing[]
}

model Briefing {
  id              String        @id @default(uuid())
  content         String
  createdAt       DateTime      @default(now())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id])
  citations       Citation[]
}

model Citation {
  id            String   @id @default(uuid())
  url           String
  publishedDate String?
  briefingId    String
  briefing      Briefing @relation(fields: [briefingId], references: [id])
}

model SearchCache {
  id             String   @id @default(uuid())
  query          String
  queryEmbedding Unsupported("vector")
  results        Json
  createdAt      DateTime @default(now())
}
